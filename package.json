{
  "name": "dsrupt-after-effects-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Dsrupt After Effects MCP: a local stdio MCP server that connects an AI agent to Adobe After Effects (Windows and macOS) with structured inspection, catalogued operations, frame rendering, and MCP-served skills.",
  "keywords": [
    "adobe",
    "after-effects",
    "aftereffects",
    "dsrupt",
    "extendscript",
    "mcp",
    "model-context-protocol",
    "motion-graphics",
    "skills"
  ],
  "homepage": "https://github.com/Dsrupt-Technologies/dsrupt-after-effects-mcp#readme",
  "bugs": {
    "url": "https://github.com/Dsrupt-Technologies/dsrupt-after-effects-mcp/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Dsrupt Technologies",
    "url": "https://dsrupt.ai"
  },
  "contributors": [
    {
      "name": "kumo.productions, Inc. (upstream mcp-aftereffects)",
      "url": "https://github.com/kumoproductions/mcp-aftereffects"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dsrupt-Technologies/dsrupt-after-effects-mcp.git"
  },
  "bin": {
    "dsrupt-after-effects": "dist/cli/index.js",
    "dsrupt-after-effects-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "jsx",
    "skills",
    "fixtures",
    "LICENSE",
    "UPSTREAM.md",
    "README.md",
    "docs"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:jsx": "vitest run tests/lint-jsx.test.ts",
    "docs:tools": "npm run build && node scripts/generate-tools-doc.mjs",
    "docs:tools:check": "npm run build && node scripts/generate-tools-doc.mjs --check",
    "check": "npm run skills:check && npm run typecheck && npm run typecheck:test && npm run lint && npm run format:check && npm run lint:jsx && npm run docs:tools:check",
    "prepare": "lefthook install",
    "test:offline": "vitest run --exclude \"tests/e2e/**\"",
    "skills:manifest": "node scripts/generate-skills-manifest.mjs",
    "skills:check": "node scripts/generate-skills-manifest.mjs --check && node scripts/check-skills.mjs",
    "doctor": "node dist/cli/index.js doctor",
    "check-ae": "node dist/cli/index.js check-ae",
    "smoke": "node scripts/live-smoke.mjs",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
